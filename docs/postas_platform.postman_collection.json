            "description": "POST /api/v1/document-extractions/process",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"uuid\": \"{{$guid}}\",\n  \"tenant_id\": \"{{tenant_id}}\",\n  \"file_url\": \"{{document_file_url}}\",\n  \"status\": \"pending\",\n  \"provider\": \"{{ai_provider}}\",\n  \"metadata\": {\n    \"source\": \"postman\"\n  },\n  \"source_request_id\": \"postman-{{$guid}}\"\n}",
