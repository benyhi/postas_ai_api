    {
      "name": "Extraccion de documentos",
      "description": "Solicitudes del modulo Extraccion de documentos.",
      "item": [
        {
          "name": "Procesar extraccion documental",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP esperado (200)', () => pm.expect(pm.response.code).to.be.oneOf([200]));",
                  "if (pm.response.code >= 200 && pm.response.code < 300 && pm.response.text()) {",
                  "  const data = pm.response.json();",
                  "  const captured = data.uuid;",
                  "  if (captured) pm.collectionVariables.set('document_extraction_uuid', captured);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-Postas-AI-Token",
                "value": "{{ai_token}}",
                "type": "text"
              },
              {
                "key": "X-Postas-Source",
                "value": "{{ai_source}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{platform_base_url}}/api/v1/document-extractions/process",
              "host": [
                "{{platform_base_url}}"
